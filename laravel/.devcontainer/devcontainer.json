{
    "name": "Laravel Dev (PhpStorm)",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "php-fpm",
    "runServices": ["php-fpm", "nginx", "blackpearl-mysql", "blackpearl-redis", "localstack", "clickhouse"],
    "workspaceFolder": "/var/app",
    "overrideCommand": false,
    "shutdownAction": "stopCompose",
    "containerUser": "root",
    "remoteUser": "root",
    "postCreateCommand": "composer install --no-interaction --prefer-dist && php -v && php artisan -V || true",
    "features": {
        "git": "latest",
        "github-cli": "latest"
    }
}
