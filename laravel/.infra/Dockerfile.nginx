FROM nginx:alpine
# Nginx container for production / staging

# Create app user (same UID/GID as PHP-FPM container)
RUN addgroup -g 1000 app && \
    adduser -D -u 1000 -G app app

# Copy nginx configuration (build context is ./laravel, so .infra/ is correct)
COPY .infra/nginx.conf /etc/nginx/nginx.conf

# Create necessary directories and set permissions
RUN mkdir -p /var/log/nginx /var/cache/nginx /var/run /var/app/public && \
    chown -R app:app /var/log/nginx /var/cache/nginx /var/run

# Expose port 8080
EXPOSE 8080

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

